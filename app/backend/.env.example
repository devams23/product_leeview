# Get these from https://supabase.com → Project Settings → API
# ──────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY (NOT the anon key!). It starts with "eyJ".
# This key bypasses RLS — the backend needs it to create sessions
# for any user.  The anon key (used by the frontend) won't work here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key
SUPABASE_ANON_KEY=eyJ...anon_key
# Project Settings → API → JWT Settings → JWT Secret. Used to verify user tokens.
SUPABASE_JWT_SECRET=
# Comma-separated browser origins allowed to call the API (e.g. https://leetcode.com,http://localhost:5173).
# Leave as * for local development only.
CORS_ORIGINS=*

# ── Bring your own keys ──────────────────────────────────────
# Users save their own NVIDIA NIM, OpenRouter and Deepgram keys on the dashboard profile.
# They are encrypted with this secret before they reach Supabase (table user_api_keys).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes saved keys unreadable, so users would have to re-enter them.
KEY_ENCRYPTION_KEY=
# true: fill any key a user has not saved with the server keys below (local dev, private installs).
# false: every user must bring their own keys. Use false for a public deployment.
ALLOW_SERVER_KEYS=false
# Seconds a dropped interview waits for the extension to reconnect before it is closed.
RESUME_GRACE_S=45
# Lifetime of the temporary Deepgram token the extension uses to open the mic stream.
STT_TOKEN_TTL_S=60

# Server keys: only used when ALLOW_SERVER_KEYS=true.
# Get these from https://console.deepgram.com
DEEPGRAM_API_KEY=

# Get these from https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Any chat model id from https://integrate.api.nvidia.com/v1/models. Prefer non-reasoning models:
# the interviewer speaks every reply, so time-to-answer matters more than deep thinking.
#   nvidia/llama-3.1-nemotron-70b-instruct  default: best balance of speed, coaching quality and JSON debriefs
#   nv-mistralai/mistral-nemo-12b-instruct  cheaper and faster, weaker at judging code
# A 410 "Gone" error means NVIDIA retired the model: pick another id from the list above.
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# LLM_PROVIDER: the primary, "nvidia_nim" or "openrouter" ("mock" gives canned replies for offline UI work).
# If both keys are present the other provider is the fallback: when the primary errors, the turn
# is retried on the fallback and the primary sits out for 60 seconds.
LLM_PROVIDER=nvidia_nim
# Get these from https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=moonshotai/kimi-k2.7-code

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
