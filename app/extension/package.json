{
  "name": "leeview-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --config vite.content.config.ts && vite build --config vite.auth.config.ts && vite build --config vite.editor.config.ts && vite build && node --input-type=module -e \"import{copyFileSync}from'fs';copyFileSync('manifest.json','dist/manifest.json');\"",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@deepgram/sdk": "^5.4.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
