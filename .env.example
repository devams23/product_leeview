# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# NVIDIA NIM
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Supabase — *** DO NOT mix these up ***
# service_role (~400 chars) bypasses RLS — used by the backend
# anon key (~150 chars) is used by the dashboard frontend
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key
SUPABASE_ANON_KEY=eyJ...anon_key

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WS_URL=ws://localhost:8000
